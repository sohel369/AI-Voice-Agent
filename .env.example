# ==========================================
# Voice-to-Bitrix24 Bot Configuration
# ==========================================

# 1. Bitrix24 Inbound Webhook URL
# Example: https://b24-xxxxxx.bitrix24.com/rest/1/xxxxxxxxxxxx/crm.lead.add.json
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.com/rest/1/your_token_here/crm.lead.add.json

# 2. OpenAI API Key (Optional but recommended for intelligent NLP extraction)
# If left blank, the bot will use built-in rule-based parsing
OPENAI_API_KEY=

# 3. Server Configuration
PORT=8000
HOST=0.0.0.0
